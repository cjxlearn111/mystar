<div class="article-layout">
<article class="article-shell">
  <a class="back-link" href="<%= url_for('/archives/') %>">返回文章列表</a>

  <header class="article-header">
    <div class="article-meta">
      <time datetime="<%= date_xml(page.date) %>"><%= date(page.date, 'YYYY年MM月DD日') %></time>
      <% if (page.reading_time) { %>
        <span class="meta-separator">•</span>
        <span><%= page.reading_time %></span>
      <% } %>
    </div>
    <h1 class="article-title"><%= page.title %></h1>
    <% if (page.description) { %>
      <p class="article-description"><%= page.description %></p>
    <% } %>
  </header>

  <% if (page.cover) { %>
    <figure class="article-cover">
      <img src="<%= url_for(page.cover) %>" alt="<%= page.title %>">
    </figure>
  <% } %>

  <div class="article-prose">
    <%- page.content %>
  </div>
</article>

<aside class="article-toc">
  <p class="article-toc-label">目录</p>
  <%- toc(page.content, { list_number: false, max_depth: 3 }) %>
</aside>

<%# 目录交互：滚动时展开并高亮当前章，脚本接管前目录保持完整显示 %>
<script src="<%= url_for('/js/article-toc.js') %>" defer></script>
</div>
