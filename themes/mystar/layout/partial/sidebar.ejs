<% const profile = theme.profile || {}; %>
<% const navigation = Array.isArray(profile.navigation) ? profile.navigation : []; %>

<aside class="profile-sidebar">
  <div class="profile-sidebar-inner">
    <% const wechat = profile.wechat || {}; %>
    <% if (wechat.image) { %>
      <input type="checkbox" id="wechat-popup-toggle" class="wechat-popup-toggle" aria-label="关闭微信二维码">
      <%# arriving from the Kaya landing page with #wechat opens the popup,
          then the hash is dropped so a refresh does not re-open it. %>
      <script>
        (function () {
          if (window.location.hash !== '#wechat') return;
          var box = document.getElementById('wechat-popup-toggle');
          if (box) box.checked = true;
          history.replaceState(null, '', window.location.pathname + window.location.search);
        })();
      </script>
    <% } %>

    <div class="profile-identity">
      <% if (profile.avatar) { %>
        <img class="profile-avatar" src="<%= url_for(profile.avatar) %>" alt="<%= profile.name || 'Profile' %>" width="80" height="80">
      <% } else { %>
        <div class="profile-avatar profile-avatar-placeholder" aria-hidden="true"><%= profile.initials || 'CJX' %></div>
      <% } %>
      <h2 class="profile-name"><%= profile.name || '陈嘉希' %></h2>
      <p class="profile-role"><%= profile.role || 'Product Planner / 3D + AI' %></p>
    </div>

    <nav class="profile-navigation" aria-label="个人履历导航">
      <% navigation.forEach(function(item, index) { %>
        <a class="profile-nav-link<%= index === 0 && is_home() ? ' is-active' : '' %>" href="<%= url_for(item.href || '/') %>">
          <span class="profile-nav-index"><%= String(index + 1).padStart(2, '0') %></span>
          <span><%= item.label %><% if (item.meta) { %> / <%= item.meta %><% } %></span>
        </a>
      <% }); %>
    </nav>

    <div class="profile-contact">
      <% if (wechat.image) { %>
        <label class="profile-contact-wechat" for="wechat-popup-toggle">
          <span class="profile-contact-label"><%= wechat.label || 'WeChat' %></span>
          <span class="profile-contact-wechat-thumb">
            <img src="<%= url_for(wechat.image) %>" alt="微信二维码" width="44" height="44" loading="lazy" decoding="async">
          </span>
        </label>
      <% } %>
      <% if (profile.email) { %>
        <a href="mailto:<%= profile.email %>">
          <span class="profile-contact-label">Email</span>
          <span><%= profile.email %></span>
        </a>
      <% } %>
      <% if (profile.phone) { %>
        <a href="tel:<%= profile.phone %>">
          <span class="profile-contact-label">Tel</span>
          <span><%= profile.phone %></span>
        </a>
      <% } %>
      <% if (profile.portfolio) { %>
        <a href="<%= profile.portfolio %>" target="_blank" rel="noreferrer">
          <span class="profile-contact-label">Work</span>
          <span>在线作品集 ↗</span>
        </a>
      <% } %>
    </div>

    <p class="profile-copyright">© <%= date(new Date(), 'YYYY') %> MYSTAR.</p>

    <% if (wechat.image) { %>
      <div class="wechat-popup" role="dialog" aria-modal="true" aria-label="微信联系方式">
        <label class="wechat-popup-backdrop" for="wechat-popup-toggle" aria-label="关闭"></label>
        <div class="wechat-popup-body">
          <img src="<%= url_for(wechat.image) %>" alt="微信二维码" loading="lazy" decoding="async">
          <p class="wechat-popup-caption"><%= wechat.caption || '扫码添加我为朋友。' %></p>
          <label class="wechat-popup-close" for="wechat-popup-toggle">关闭</label>
        </div>
      </div>
    <% } %>
  </div>
</aside>
