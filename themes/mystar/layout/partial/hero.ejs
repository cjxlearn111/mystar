<% const hero = theme.home && theme.home.hero ? theme.home.hero : {}; %>

<section id="intro" class="hero container-shell">
  <div class="hero-copy">
    <p class="section-label"><%= hero.note || hero.label || 'Editorial Notes' %></p>
    <h1 class="hero-title hero-intent-title">
      <%= hero.title || 'Building a quiet, curated home for thoughtful work.' %>
    </h1>
    <p class="hero-description">
      <%= hero.description || '一个面向设计、系统与知识沉淀的个人博客与内容档案。这里会逐步承载文章、实验与长期思考。' %>
    </p>
    <div class="hero-actions">
      <a class="primary-button" href="<%= url_for(hero.cta_link || '/archives/') %>"><%= hero.cta_text || '浏览履历' %></a>
      <% (hero.secondary || []).forEach(function (item) { %>
        <a class="secondary-button" href="<%= item.external ? item.link : url_for(item.link) %>"<% if (item.download) { %> download="<%= item.download %>"<% } %><% if (item.external) { %> target="_blank" rel="noreferrer"<% } %>><%= item.text %></a>
      <% }); %>
    </div>
    <div class="hero-notes">
      <p class="hero-note hero-note-primary"><%= hero.note_secondary || '把复杂的生成能力，做成创作者顺手可用的工具。' %></p>
    </div>
  </div>
  <div class="hero-visual">
    <div class="hero-image">
      <img src="<%= url_for(hero.image || '/images/site/aaf9412a0256e7ffac1039eaa1fb2821.jpg') %>" alt="<%= hero.image_alt || 'Homepage hero landscape' %>" loading="eager" fetchpriority="high" decoding="async" width="1600" height="1600">
    </div>
    <div class="floating-card">
      <p class="floating-label"><%= hero.card_label || 'In Progress' %></p>
      <h3><%= hero.card_title || 'mystar theme system' %></h3>
      <p><%= hero.card_description || '基于我们已整理的设计系统持续打磨。' %></p>
    </div>
  </div>
</section>
